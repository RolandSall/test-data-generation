{
  "name": "test-data-generation-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": { "node": ">=22.22" },
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "bun run --cwd packages/test-data build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages scripts examples playground --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "examples": "bun run build && bun examples/index.ts",
    "examples:test": "bun run build && tsc --noEmit -p examples/tsconfig.json && vitest run --config examples/vitest.config.ts",
    "playground": "bun run build && bun playground/index.ts",
    "playground:test": "bun run build && tsc --noEmit -p playground/tsconfig.json && vitest run --config playground/vitest.config.ts",
    "pack:check": "bun scripts/verify-package.ts",
    "compatibility:check": "bun scripts/check-peer-compatibility.ts",
    "docs:sync": "bun scripts/sync-readme.ts",
    "docs:check": "bun scripts/sync-readme.ts --check && bun scripts/check-docs.ts",
    "release:check": "bun scripts/verify-release.ts",
    "audit": "bun audit --ignore 1241202",
    "audit:all": "bun audit",
    "verify": "bun run audit && bun run typecheck && bun run lint && bun run test:coverage && bun run examples:test && bun run playground:test && bun run docs:check && bun run pack:check"
  },
  "devDependencies": {
    "@integration-testing/test-data-generation": "workspace:*",
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.35.0",
    "typescript-eslint": "^8.42.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "4.1.11",
    "jest": "30.5.2",
    "@jest/globals": "30.5.2",
    "zod": "4.6.5",
    "protobufjs": "8.8.0",
    "ajv": "^8.17.1",
    "validator": "^13.15.15",
    "@types/validator": "^13.15.0"
  },
  "overrides": { "esbuild": "0.28.1" }
}
